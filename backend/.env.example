ANAKIN_API_KEY=
ANAKIN_BASE_URL=https://api.anakin.io/v1
ANAKIN_COUNTRY=in
ANAKIN_POLL_INTERVAL_MS=3000
ANAKIN_POLL_TIMEOUT_MS=120000
MAX_TENDER_URLS=10
MAX_AGENT_ITERATIONS=2

# LLM filter (OpenRouter, OpenAI-compatible). Optional — falls back to heuristics if missing.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.5
